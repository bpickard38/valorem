# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Shopify (required) -------------------------------------------------------
# Store's myshopify.com domain, no https://  e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API (Headless channel). Private token preferred; public is the fallback.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_TOKEN=

# Admin API via a Dev Dashboard app (client-credentials grant, token cached 24h).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: a fixed legacy custom-app token (shpat_...) instead of the client grant.
SHOPIFY_ADMIN_TOKEN=

# --- Meta (optional) ----------------------------------------------------------
# Browser pixel + server-side Conversions API relay (deduplicated by event_id).
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
# Set to route events to Events Manager's Test Events tab.
META_TEST_EVENT_CODE=

# --- Reviews (optional) -------------------------------------------------------
# Judge.me REST API. Use the store's permanent *.myshopify.com domain.
JUDGEME_SHOP_DOMAIN=
JUDGEME_API_TOKEN=

# --- Contact form (optional) --------------------------------------------------
# Web3Forms public access key for /contact.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
